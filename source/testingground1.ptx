        <image source="fig_9_1_left_hand">
          <description>
            <p>Three mutually perpendicular line segments labeled <m>x</m>, <m>y</m>, and <m>z</m>. They are arranged so that the segment labeled <m>z</m> points up, the segment labeled <m>x</m> points to the right, and the segment labeled <m>y</m> is coming out of the page.
            </p>
          </description>
        </image>
      </figure>
      <figure xml:id="fig-coord-sys-right-hand">
        <caption>A right hand system</caption>
        <image source="fig_9_1_right_hand">
          <description>
            <p>Three mutually perpendicular line segments labeled <m>x</m>, <m>y</m>, and <m>z</m>. They are arranged so that the segment labeled <m>z</m> points up, the segment labeled <m>y</m> points to the right, and the segment labeled <m>x</m> is coming out of the page.
            </p>
          </description>
        </image>
      </figure>
    </sidebyside>
  </figure>

<figure xml:id="F-9-1-left-right-hand2">
