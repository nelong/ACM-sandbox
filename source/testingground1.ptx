            plot14+=text3d("-2",(1.5,-1,0),color="blue",fontsize=25)
            plot14+=text3d("1",(0.5,-1.5,0),color="red",fontsize=25)
            plot14+=text3d("3",(1.25,-2.25,1.5),color="green",fontsize=25,viewpoint=[[-0.1881,-0.4978,-0.8467],144.52],camera_position=[6.4253,5.8609,5.8282])
            plot14
          </sageplot>
        </image>
        <image>
          <description><p>A plot with perpendicular arrows labeled x, y, and z. A point is labeled P with coordinates (1,-2,3) and a vertical green segment from the point to the xy-plane. A red segment from the intersection of the green segment with the xy-plane and at the y-axis is shown and labeled with 1. A blue segment from the intersection of the green segment with the xy-plane and the x-axis is shown and labeled with a -2.</p></description>
          <sageplot variant="3d" label="point3d-coordplanes">
            from sage.plot.plot3d.plot3d import axes
            var('t,s')
            plot14=axes(4.25,2,color="black",frame=False,aspect_ratio=1)+text3d("x",(4.5,0,0),fontsize=30)+text3d("y",(0,4.5,0),fontsize=30)+text3d("z",(0,0,4.5),fontsize=30)
            plot14+=point3d((1,-2,3),size=60,color="black")
            plot14+=text3d("P=(1,-2,3)",(2.25,-3.75,3.25),color="black",fontsize=25)
            plot14+=parametric_plot3d((s,t,0),(s,-4,4),(t,-4,4),color="green",opacity=.25,frame=False,mesh=True,plot_points=3)
            plot14+=parametric_plot3d((0,t,s),(s,-4,4),(t,-4,4),color="red",opacity=.25,frame=False,mesh=True,plot_points=3)
            plot14+=parametric_plot3d((s,0,t),(s,-4,4),(t,-4,4),color="blue",opacity=.25,frame=False,mesh=True,plot_points=3)
            plot14+=parametric_plot3d((t,-2,3),(t,0,1),thickness=3,color="red")
            plot14+=parametric_plot3d((1,-t,3),(t,0,2),color="blue",thickness=3)
            plot14+=parametric_plot3d((1,-2,t),(t,0,3),color="green",thickness=3)
            plot14+=text3d("-2",(1.5,-1,2.75),color="blue",fontsize=25)
            plot14+=text3d("1",(0.5,-1.5,3.5),color="red",fontsize=25)
            plot14+=text3d("3",(1.25,-2.25,1.5),color="green",fontsize=25,viewpoint=[[-0.4007,-0.4767,-0.7824],113.33],camera_position=[13.4605,2.0255,6.9743])
            plot14
          </sageplot>
        </image>
      </sidebyside>
    </figure>

