  </figure>

  <figure xml:id="coord2d-measurement">
      <caption>A plot with the 2D coordinate measurements labeled</caption>
      <image width="55%" xml:id="img-coord2d-measurement">
        <description><p>A plot with the two-dimensional coordinate measurements labeled for a point in the first quadrant and a point in the fourth quadrant</p></description>
        <sageplot>
          var('t')
          plot11=point((3,1),color="black",size=60,axes=True,zorder=5,axes_labels=["$x$","$y$"],ticks=[[],[]],fontsize=25)
          plot11+=line([(0,1),(3,1)],color="red",thickness=3)+line([(3,0),(3,1)],color="blue",thickness=3)
          plot11+=text("$a$",(1.5,1.3),color="red",fontsize=30)+text("$b$",(3.3,0.5),color="blue",fontsize=30)
          plot11+=text("$P=(a,b)$",(3.3,1.3),color="black",fontsize=30)+text("$Q=(c,d)$",(2.3,-2.3),color="black",fontsize=30)
          plot11+=point((2,-2),color="black",size=60,zorder=5)
          plot11+=line([(0,-2),(2,-2)],color="red",thickness=3)+line([(2,0),(2,-2)],color="blue",thickness=3)
          plot11+=text("$c$",(1,-1.7),color="red",fontsize=30)+text("$d$",(2.3,-1),color="blue",fontsize=30,xmin=-1,xmax=4.5,ymin=-2,ymax=2.5,aspect_ratio=1)
          plot11.axes_width(3)
          plot11
        </sageplot>
      </image>
    </figure>

    <figure xml:id="coor-planes">
      <caption>The coordinate planes in three dimensions</caption>
      <interactive label="interactive-coor-plane" platform="sage" width="97%" aspect="1:1.24">
        <description><p>An interactive plot that shows planes that contain the x and y axes for the first option, the x and z axes for the second option, and the y and z axes for the third option.</p>
      </description>
      <slate surface="sage">
          from sage.plot.plot3d.plot3d import axes
          var('t,s')
          d=4
          @interact
          def coordplanes(xyp=checkbox(False,'Show xy-plane'),xzp=checkbox(True,'Show xz-plane'),yzp=checkbox(False,'Show yz-plane')):
            plot12=axes(3.5,2,color="black")+text3d("x",(4,0,0),fontsize=30)+text3d("y",(0,4,0),fontsize=30)+text3d("z",(0,0,4),fontsize=30)
            if(xyp):
              plot12+=parametric_plot3d((s,t,0),(s,-3,3),(t,-3,3),color="green",opacity=.25,frame=False,mesh=True,plot_points=3)
              plot12+=text3d("xy-plane",(d,-d,0.5),fontsize=25,color="green")
            if(xzp):
              plot12+=parametric_plot3d((s,0,t),(s,-3,3),(t,-3,3),color="blue",opacity=.25,frame=False,mesh=True,plot_points=3)
              plot12+=text3d("xz-plane",(-d,0,d),fontsize=25,color="blue")
            if(yzp):
              plot12+=parametric_plot3d((0,t,s),(s,-3,3),(t,-3,3),color="red",opacity=.25,frame=False,mesh=True,plot_points=3)
              plot12+=text3d("yz-plane",(0,-d,d),fontsize=25,color="red")
            show(plot12,aspect_ratio=1,viewpoint=[[-0.23,-0.5945,-0.7705],146.8],camera_position=[12.3011,13.494,5.4476])
        </slate>
      </interactive> 
    </figure>


    <figure xml:id="octants">
       <caption>A plot of the eight octants </caption>
       <image>
        <description>
          <p>
            A plot with the plane through the x and y axes shown in green, the plane through the x and z axes in blue, and the plane through the y and z axes shown in red. Additionally, in the direction of points with positive x, y, and z coordinates, the first octant is labeled. An option to show labels for the second through eight octants shown moving counterclockwise around the z-axis. 
          </p>
        </description>
        <sageplot variant='3d' label='interactive-octants'>
          from sage.plot.plot3d.plot3d import axes
          var('t,s')
          plot3=axes(3.5,2,color="black")+text3d("x",(3.75,0,0),fontsize=30)+text3d("y",(0,3.75,0),fontsize=30)+text3d("z",(0,0,3.75),fontsize=30)
          plot3+=parametric_plot3d((s,t,0),(s,-3,3),(t,-3,3),color="green",opacity=.25,frame=False,mesh=True,plot_points=2)
          plot3+=parametric_plot3d((0,t,s),(s,-3,3),(t,-3,3),color="red",opacity=.25,frame=False,mesh=True,plot_points=2)
          plot3+=parametric_plot3d((s,0,t),(s,-3,3),(t,-3,3),color="blue",opacity=.25,frame=False,mesh=True,plot_points=2)
          d=2
          plot3+=text3d("First Octant",(2,2,2),fontsize=25,aspect_ratio=1,viewpoint=[[-0.2656,-0.6008,-0.754],143.12],camera_position=[11.3891,10.3947,3.7861])
          names=["2nd","3rd", "4th","5th","6th","7th","8th"]
          locations=[(-d,d,d),(-d,-d,d),(d,-d,d),(d,d,-d),(-d,d,-d),(-d,-d,-d),(d,-d,-d)]
          for i in range(len(names)):
              plot3+=text3d(names[i],locations[i],fontsize=20,color='gray')
          plot3
        </sageplot>
       </image>
    </figure>



    <figure xml:id="point-in3d">
      <caption>A plot of the point <m>(1,-2,3)</m></caption>
      <interactive label="interactive-point-in3d" platform="sage" width="100%" aspect="1:1.25">
        <description><p>A plot with perpendicular arrows labeled x, y, and z. A point is labeled P with coordinates (1,-2,3) and a vertical green segment from the point to the xy-plane. A red segment from the intersection of the green segment with the xy-plane and at the y-axis is shown and labeled with 1. A blue segment from the intersection of the green segment with the xy-plane and the x-axis is shown and labeled with a -2.</p></description>
        <slate surface="sage">
          from sage.plot.plot3d.plot3d import axes
          var('t,s')
          @interact
          def pointin3d(supports=checkbox(True, label='Show Segments'),coordplanes=checkbox(False,label='Show Coordinate Planes')):
            plot14=axes(4.25,2,color="black",frame=False,aspect_ratio=1)+text3d("x",(4.5,0,0),fontsize=30)+text3d("y",(0,4.5,0),fontsize=30)+text3d("z",(0,0,4.5),fontsize=30)
            plot14+=point3d((1,-2,3),size=50,color="black")
            plot14+=text3d("P=(1,-2,3)",(2.25,-3.25,3.25),color="black",fontsize=25)
            if(supports):
              plot14+=parametric_plot3d((t,-2,0),(t,0,1),thickness=3,color="red")+parametric_plot3d((1,-t,0),(t,0,2),color="blue",thickness=3)
              plot14+=parametric_plot3d((1,-2,t),(t,0,3),color="green",thickness=3)
              plot14+=line([(0,0,0),(0,-3,0)],color="black",style="-")
              plot14+=text3d("-2",(1.5,-1,0),color="blue",fontsize=25)
              plot14+=text3d("1",(0.5,-1.5,0),color="red",fontsize=25)
              plot14+=text3d("3",(1.25,-2.25,1.5),color="green",fontsize=25)
            if(coordplanes):
              plot14+=parametric_plot3d((s,t,0),(s,-4,4),(t,-4,4),color="green",opacity=.25,frame=False,mesh=True,plot_points=3)
              plot14+=parametric_plot3d((0,t,s),(s,-4,4),(t,-4,4),color="red",opacity=.25,frame=False,mesh=True,plot_points=3)
              plot14+=parametric_plot3d((s,0,t),(s,-4,4),(t,-4,4),color="blue",opacity=.25,frame=False,mesh=True,plot_points=3)
              plot14+=parametric_plot3d((t,-2,3),(t,0,1),thickness=3,color="red")
              plot14+=parametric_plot3d((1,-t,3),(t,0,2),color="blue",thickness=3)
              plot14+=parametric_plot3d((1,-2,t),(t,0,3),color="green",thickness=3)
              plot14+=text3d("-2",(1.5,-1,3),color="blue",fontsize=25)
              plot14+=text3d("1",(0.5,-1.5,3),color="red",fontsize=25)
              plot14+=text3d("3",(1.25,-2.25,1.5),color="green",fontsize=25)
            show(plot14)
        </slate>
      </interactive>
    </figure>

    <figure xml:id="point-in3dasdf">
      <sidebyside>
        <image>
          <description><p>A plot with perpendicular arrows labeled x, y, and z. A point is labeled P with coordinates (1,-2,3) and a vertical green segment from the point to the xy-plane. A red segment from the intersection of the green segment with the xy-plane and at the y-axis is shown and labeled with 1. A blue segment from the intersection of the green segment with the xy-plane and the x-axis is shown and labeled with a -2.</p></description>
